#pragma once

#include "secrets.h"

// -----------------------------------------------------------------------------
// Example config to make a local override easy.
// This file is intentionally public-safe and kept as a template only.
// Use a local `include/config.h` or `include/secrets.h` for real settings.
// -----------------------------------------------------------------------------

#define DEVICE_NAME "OBD2MQTTS-ESP32"
#define DEVICE_HOSTNAME "obd2mqtts"

// --- MQTT over TLS (MQTTS) ---
#define MQTT_PORT 8883                    // MQTTS secure port
#define MQTT_USE_TLS 1                    // 1 = MQTTS (TLS/SSL), 0 = plain MQTT
#define MQTT_CLIENT_ID "obd2mqtts-client"
#define MQTT_TOPIC_TELEMETRY "obd2/telemetry"
#define MQTT_TOPIC_STATUS "obd2/status"
#define MQTT_TOPIC_POWER "obd2/power"
#define MQTT_TOPIC_GNSS "obd2/gnss"
#define MQTT_TOPIC_TRIP "obd2/trip"
#define MQTT_CA_CERT_NAME "obd2mqtts-ca.pem"
#define CELLULAR_NTP_SERVER "pool.ntp.org"

#define OTA_PORT 3232

#define SERIAL_BAUD 115200
#define ENABLE_SERIAL_DIAGNOSTICS 1
#define CELLULAR_APN "YOUR_CARRIER_APN"
#define CELLULAR_APN_USER ""
#define CELLULAR_APN_PASSWORD ""
#define CELLULAR_SIM_PIN ""
#define CHECK_INTERVAL_MS 1000
#define REPORT_INTERVAL_MS 5000
#define GNSS_POLL_INTERVAL_MS 60000

// Set to 1 only after a suitable 10k NTC replaces R27 and TS wiring is verified.
#define AXP2101_NTC_INSTALLED 0
#define AXP2101_ENABLE_BATTERY_CHARGING 0
#define AXP2101_NTC_PROTECTION_VERIFIED 0
#define AXP2101_ALLOW_UNVERIFIED_BENCH_CHARGING 0
